{"accessible_name":"Axiom scheme of Separation","bound_asset_paths":[],"column":1,"diagram_id":null,"exercise_solution_status":null,"expression_ids":["expr-4b7ce6b75f0ec36f","expr-559aead08264d579","expr-71c0b2f5b1db0328"],"file":"content/set-theory/z/separation.tex","formal_object_id":"projected-env-004204","formula_binding_interval":{"authority":"FROZEN_PROJECTED_CONTENT_INTERVAL_PLUS_EXACT_SHARED_ENVIRONMENT_SPAN","exact_shared_environment_formula_ids":[]},"formula_ids":["projected-formula-0030392","projected-formula-0030393","projected-formula-0030394"],"line":10,"listen_text":"For every formula phi of x and every set capital A, the subset of capital A containing exactly the x for which phi holds exists. This is an axiom scheme, not one axiom.","long_description":"For every formula phi of x and every set capital A, the subset of capital A containing exactly the x for which phi holds exists. This is an axiom scheme, not one axiom.","object_role":"axiom","record_sha256":"2e496621cb341f1d9cb26c651671a397fe543ca176ddbb3aaddec5b3a937cd0a","review_decision":"Fresh source-reading shard; producer-side authoring, not independent acceptance.","source_formal_object":{"chapter_key":"sth:z","column":1,"content_end":2221966,"content_start":2221837,"environment_id":"projected-env-004204","file":"content/set-theory/z/separation.tex","instance_id":"inst-00591","line":10,"name":"axiom","object_class":"axiom","offset":200,"part_key":"sth","scope":"projected","stream_end":2221977,"stream_start":2221824},"source_formal_object_sha256":"256fde40f93d1af8758f91f56ea696a522cb373ab90bb2f93237ef57691e98b0","source_order_index":1}
