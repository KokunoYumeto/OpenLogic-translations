{"accessible_name":"Proposition establishing the empty set","bound_asset_paths":[],"column":1,"diagram_id":null,"exercise_solution_status":null,"expression_ids":["expr-8d2cacefc75ba038"],"file":"content/set-theory/z/separation.tex","formal_object_id":"projected-env-004208","formula_binding_interval":{"authority":"FROZEN_PROJECTED_CONTENT_INTERVAL_PLUS_EXACT_SHARED_ENVIRONMENT_SPAN","exact_shared_environment_formula_ids":[]},"formula_ids":["projected-formula-0030420"],"line":77,"listen_text":"If any set exists, then the empty set exists. Separation forms it from the members of an arbitrary set that are not equal to themselves.","long_description":"If any set exists, then the empty set exists. Separation forms it from the members of an arbitrary set that are not equal to themselves.","object_role":"proposition","record_sha256":"d577b863fcc70c2fc01b0d55ec9279a4d71641e3997b55ef24b2c7d24f52bb34","review_decision":"Fresh source-reading shard; producer-side authoring, not independent acceptance.","source_formal_object":{"chapter_key":"sth:z","column":1,"content_end":2225024,"content_start":2224951,"environment_id":"projected-env-004208","file":"content/set-theory/z/separation.tex","instance_id":"inst-00591","line":77,"name":"prop","object_class":"proposition","offset":3315,"part_key":"sth","scope":"projected","stream_end":2225034,"stream_start":2224939},"source_formal_object_sha256":"2bef4ea532cc8e266813e172fdba9e72cba163d8930a8efbc2a58c73173ad1e1","source_order_index":4}
