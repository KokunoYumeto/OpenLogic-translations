    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/fonts/bn-slc-txexs.cmap",
      "to": "locale/{locale}/courses/{book}/fonts/bn-slc-txexs.cmap"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/fonts/bn-slc-txsyc.cmap",
      "to": "locale/{locale}/courses/{book}/fonts/bn-slc-txsyc.cmap"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/fonts/bn-slc-txsys.cmap",
      "to": "locale/{locale}/courses/{book}/fonts/bn-slc-txsys.cmap"
    }
