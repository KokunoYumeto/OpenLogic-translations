    "include/glossary-adapter.tex",
    "nowidow.sty",
    "fonts/bn-slc-newtx-unicode.map",
    "fonts/bn-slc-txexas.cmap",
    "fonts/bn-slc-txexs.cmap",
    "fonts/bn-slc-txsyc.cmap",
    "fonts/bn-slc-txsys.cmap"
  ],
  "legacy_overlays": []
