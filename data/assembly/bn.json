{
  "schema_version": 1,
  "locale": "bn",
  "product": "slc-screen-pdf",
  "book": "sets-logic-computation",
  "source_id": "slc",
  "manifest": "courses/sets-logic-computation/MANIFEST.json",
  "manifest_pins": {
    "olp": "olp",
    "slc": "slc",
    "portraits": "portrait_assets",
    "photos": "photo_assets"
  },
  "upstream_include": [
    "content/*",
    "sty/*",
    "include/*",
    "assets/*",
    "open-logic-*.sty",
    "LICENSE.md",
    "bib/natbib-oup.bst",
    "locale/LOCALIZATION.md"
  ],
  "assets": [
    {
      "source": "portraits",
      "to": "assets/portraits",
      "include": [
        "*-circle.pdf",
        "LICENSE.md"
      ]
    },
    {
      "source": "photos",
      "to": "assets/photos",
      "include": [
        "*-credit.tex",
        "*-large.png",
        "*-small.png",
        "README.md"
      ]
    },
    {
      "source": "slc",
      "to": "locale/bn/courses/sets-logic-computation",
      "include": [
        "illustrations/*Chapter.png"
      ]
    }
  ],
  "files": [
    {
      "source": "book",
      "from": "courses/sets-logic-computation/LICENSE.md",
      "to": "locale/{locale}/courses/{book}/LICENSE.md"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/slc-config.sty",
      "to": "locale/{locale}/courses/{book}/slc-config.sty"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/slc-envs.sty",
      "to": "locale/{locale}/courses/{book}/slc-envs.sty"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/slc-metadata.tex",
      "to": "locale/{locale}/courses/{book}/slc-metadata.tex"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/assets/tex/nowidow/nowidow.sty",
      "to": "locale/{locale}/courses/{book}/nowidow.sty"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/assets/tex/nowidow/nowidow.dtx",
      "to": "locale/{locale}/courses/{book}/nowidow.dtx"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/assets/tex/nowidow/nowidow.ins",
      "to": "locale/{locale}/courses/{book}/nowidow.ins"
    },
    {
      "source": "book",
      "from": "courses/sets-logic-computation/assets/tex/nowidow/README",
      "to": "licenses/nowidow/README"
    },
    {
      "source": "edition",
