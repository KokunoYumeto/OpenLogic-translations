  "reader_guide_choice_records": [
    {
      "id": "P01",
      "text": "په دې منجمده نسخه کښې له ۷۲۲ سرچينو څخه ۶۶۸ سرچينيزې مسودې شته؛ ۵۴ پاتې دي۔ PDF او EPUB لا لومړي ۳۲۱ واحدونه لري؛ د v0.7.1 خپرونې سرچينو ZIP د ۴۰۵ مسودو فايلونه لري۔ دا لا بشپړ کتاب نۀ دے۔",
      "rationale_ps": "د سرچينې، پخوانۍ خپرونې او اوسني لوستونکي شمېرې جلا پرتله شوې؛ د مسودې د بشپړ کتاب په توګه وړاندې کول ناسم دي۔",
      "canon_consulted": [
        "PK-IQRAM-P2-SEMANTICS"
      ],
      "canon_role": "د علمي نثر او ليکدود محدوده بېلګه؛ عددي شواهد د فايلونو له پرتله اخيستل شوي۔",
      "editorial_confidence": "د شمېرنو او نسبت شواهد مستقيم دي؛ ژبنی باور کچه‌بندي شوې احتمالي شمېره نۀ ده۔",
      "human_review_gate": false,
      "prior_wording_evidence": "PASHTO664_PUBLIC_INTAKE_20261001.json",
      "current_change_scope": "د پخواني بيان کارونه؛ شمېرې او حدود له اوسني ثبت سره پرتله شوي دي۔"
    },
    {
      "id": "P02",
      "text": "له پخوانۍ ۶۶۴-واحديزې نسخې وروسته ۴ سرچينيز واحدونه زيات شوي دي: ۲۷ نوې ژباړل شوې ټوټې او ۱۹ جوړښتي ټوټې۔ ۸ پخوانۍ ژباړل شوې ټوټې هم بدلې شوې دي۔ د وروستي بدلون په عامه ثبت کښې ۴۴ بدل شوي فايلونه له ثبت شوو بايټونو او هشونو سره برابر دي۔ دا د فايلونو او تړاوونو کتنه ده، د ټولو ژبنیو انتخابونو تصديق نۀ دے۔",
