  "reader_guide_choice_records": [
    {
      "id": "P01",
      "text": "په دې منجمده نسخه کښې له ۷۲۲ سرچينو څخه ۶۷۴ سرچينيزې مسودې شته؛ ۴۸ پاتې دي۔ PDF او EPUB لا لومړي ۳۲۱ واحدونه لري؛ د v0.7.1 خپرونې سرچينو ZIP د ۴۰۵ مسودو فايلونه لري۔ دا لا بشپړ کتاب نۀ دے۔",
      "rationale_ps": "د سرچينې، پخوانۍ خپرونې او اوسني لوستونکي شمېرې جلا پرتله شوې؛ د مسودې د بشپړ کتاب په توګه وړاندې کول ناسم دي۔",
      "canon_consulted": [
        "PK-IQRAM-P2-SEMANTICS"
      ],
      "canon_role": "د علمي نثر او ليکدود محدوده بېلګه؛ عددي شواهد د فايلونو له پرتله اخيستل شوي۔",
      "editorial_confidence": "د شمېرنو او نسبت شواهد مستقيم دي؛ ژبنی باور کچه‌بندي شوې احتمالي شمېره نۀ ده۔",
      "human_review_gate": false,
      "prior_wording_evidence": "PASHTO668_PUBLIC_INTAKE_20261001.json",
      "current_change_scope": "د پخواني بيان کارونه؛ شمېرې او حدود له اوسني ثبت سره پرتله شوي دي۔"
    },
    {
      "id": "P02",
      "text": "له پخوانۍ ۶۶۸-واحديزې نسخې وروسته ۶ سرچينيز واحدونه زيات شوي دي: ۳۸ نوې ژباړل شوې ټوټې او ۳۲ جوړښتي ټوټې۔ ۱۰ پخوانۍ ژباړل شوې ټوټې هم بدلې شوې دي۔ د وروستي بدلون په عامه ثبت کښې ۳۹ بدل شوي فايلونه له ثبت شوو بايټونو او هشونو سره برابر دي۔ دا د فايلونو او تړاوونو کتنه ده، د ټولو ژبنیو انتخابونو تصديق نۀ دے۔",
      "rationale_ps": "شمېرې د دوو منجمدو نسخو له فايلونو او جوړو ټوټو څخه دي؛ جوړښتي ټوټې د نوې ژباړې په شمېر کښې نۀ دي ګډې شوې۔",
      "canon_consulted": [
        "PK-IQRAM-P2-SEMANTICS"
