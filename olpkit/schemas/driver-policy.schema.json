{
  "type": "object",
  "properties": {
    "preamble": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_class": {"$ref": "#/$defs/templates"},
        "before_olp": {"$ref": "#/$defs/templates"},
        "after_olp": {"$ref": "#/$defs/templates"}
      }
    },
    "schema_version": {
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "transforms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "type": "string"
                },
                "matches": {
                  "type": "integer",
                  "minimum": 1
                },
                "kind": {
                  "enum": [
                    "path",
                    "preamble",
                    "label",
                    "about",
                    "layout"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "before",
                "after",
                "matches",
                "kind",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "sha256",
          "transforms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_commit",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "templates": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]+\\.tex$"}
    }
  }
}
