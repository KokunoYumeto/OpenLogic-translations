        "main": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[\\\\:]).+$"
            },
            "bold": {
              "type": "string",
              "minLength": 1
            },
            "italic": {
              "type": "string",
              "minLength": 1
            },
            "license": {
