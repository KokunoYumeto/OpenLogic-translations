{
  "type": "object",
  "$defs": {
    "renderedSymbol": {
      "type":"object", "additionalProperties":false,
      "required":["text","font","gid","program_sha256"],
      "properties": {
        "text":{"type":"string","minLength":1,"maxLength":1},
        "font":{"type":"string","minLength":1},
        "gid":{"type":"integer","minimum":1},
        "program_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }
  },
  "properties": {
    "tables": {
      "type": "object", "additionalProperties": false,
      "required": ["math", "text", "token_files"],
      "properties": {
        "math": {"const": "ltr"},
        "text": {"enum": ["ltr", "rtl"]},
        "token_files": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "symbol_mappings":{"type":"array","items":{"type":"object","additionalProperties":false,
          "required":["command","english","target"],"properties":{
            "command":{"type":"string","pattern":"^[A-Za-z]+$"},
            "english":{"$ref":"#/$defs/renderedSymbol"},"target":{"$ref":"#/$defs/renderedSymbol"}
          }}},
        "proof_labels": {"type":"array","items":{"type":"object","additionalProperties":false,
          "required":["command","english","target","path","sha256"],"properties":{
            "command":{"type":"string","pattern":"^[A-Za-z]+$"},
            "english":{"type":"string","minLength":1},"target":{"type":"string","minLength":1},
            "path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "other_source_sha256":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
          }}}
      }
    },
    "schema_version": {
      "const": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "enum": [
        "pdflatex",
        "lualatex",
        "xelatex"
      ]
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "babel": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://github\\.com/"
      }
    },
    "preamble": {
      "type": "object",
      "properties": {
        "before_class": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\.tex$"
          },
          "uniqueItems": true
        },
        "before_olp": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\.tex$"
          },
          "uniqueItems": true
        },
        "after_olp": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\.tex$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "before_class",
        "before_olp",
        "after_olp"
      ],
      "additionalProperties": false
    },
    "strings": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "type": "string",
          "minLength": 1
        },
        "biographies": {
          "type": "string",
          "minLength": 1
        },
        "glossary": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "figure",
        "biographies",
        "glossary",
        "initial"
      ],
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
