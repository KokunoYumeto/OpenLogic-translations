        "source_manifest": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[\\\\:]).+$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attribution_policy": {
          "const": "preserve-recorded-else-unresolved"
        }
      },
