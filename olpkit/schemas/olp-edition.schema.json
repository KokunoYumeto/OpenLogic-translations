    "babel",
    "engine",
    "repository",
    "products",
    "paths",
    "pins",
    "conversion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "enum": [
              "pdflatex",
              "xelatex"
            ]
          }
        }
      },
      "then": {
        "required": [
          "engine_reason"
        ]
      }
    }
  ]
