            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[\\\\:]).+\\.json$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
