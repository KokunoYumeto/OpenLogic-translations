{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "bookPin": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "upstream_tag": {
      "type": "string",
      "pattern": "^(?:[0-9]{2}\\.(?:0[1-9]|1[0-2])|none yet|untagged)$"
    },
    "schema_version": {
      "const": 1
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "language_tag": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{3}$"
    },
    "babel": {
