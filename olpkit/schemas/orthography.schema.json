{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["locale", "rules"],
  "properties": {
    "locale": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "reason", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "kind": {"enum": ["forbidden_literal", "nfc"]},
        "literal": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "sha256", "locator"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "locator": {"type": "string", "minLength": 1}
          }
        }}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "forbidden_literal"}}}, "then": {"required": ["literal"]}}]
    }}
  }
}
