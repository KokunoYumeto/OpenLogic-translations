{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "path", "before", "after", "conditions", "reason", "evidence"],
  "additionalProperties": false,
  "dependentRequired": {
    "input_sha256": ["output_sha256"],
    "output_sha256": ["input_sha256"]
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "path": {"type": "string", "minLength": 1},
    "before": {"type": "string", "minLength": 1},
    "after": {"type": "string"},
    "upstream_setting": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "phase", "use"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z]+$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9-]*$"},
        "phase": {"enum": ["before_class", "before_olp"]},
        "use": {"type": "string", "minLength": 1}
      }
    },
    "alternate_before": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1},
    "proposal": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["locale", "engine", "script"],
        "properties": {
          "locale": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "engine": {"enum": ["pdflatex", "lualatex", "xelatex"]},
          "script": {"type": "string", "pattern": "^[A-Z][a-z]{3}$"}
        }
      }
    },
    "evidence": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://github\\.com/"}
    }
  }
}
