{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{4,}$"
    },
    "src": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[\\\\:]).+$"
    },
    "src_blob": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "src_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tr_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "current",
        "stale",
        "new",
        "retired"
      ]
    },
    "by": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "ultra",
                "max",
                "xhigh",
                "high",
                "medium",
                "low"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T.*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "enum": [
            "translated",
            "patched",
            "carried",
            "inherited"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "effort",
        "date",
        "method",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "effort": {
                "type": "null"
              },
              "method": {
                "const": "inherited"
              }
            }
          },
          "else": {
            "properties": {
              "effort": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "id",
    "src",
    "path",
    "src_blob",
    "src_sha256",
    "tr_sha256",
    "state",
    "by"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "current",
              "stale"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "src_blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "src_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
