{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "book": {
      "type": "string",
      "minLength": 1
    },
    "driver": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.tex$"},
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "manifest_pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "upstream_include": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "source",
          "to",
          "include"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "edition",
              "book"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "transforms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "type": "string"
                },
                "matches": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "before",
                "after",
                "matches",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "source",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "trees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "edition",
              "book"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "source",
          "from",
          "to",
          "include"
        ],
        "additionalProperties": false
      }
    },
    "required_book_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "legacy_overlays": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "locale",
    "product",
    "book",
    "source_id",
    "manifest",
    "manifest_pins",
    "upstream_include",
    "assets",
    "files",
    "trees",
    "required_book_files",
    "legacy_overlays"
  ]
}
