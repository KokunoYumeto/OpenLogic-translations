{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["book", "reference_pins", "reference_mounts", "reference_dependency"],
  "properties": {
    "book": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "reference_pins": {
      "type": "object", "additionalProperties": false,
      "required": ["slc", "portraits", "photos"],
      "properties": {
        "slc": {"$ref": "#/$defs/commit"},
        "portraits": {"$ref": "#/$defs/commit"},
        "photos": {"$ref": "#/$defs/commit"}
      }
    },
    "reference_mounts": {
      "type": "object", "additionalProperties": false,
      "required": ["olp", "slc", "portraits", "photos"],
      "properties": {
        "olp": {"const": ""},
        "slc": {"$ref": "#/$defs/path"},
        "portraits": {"$ref": "#/$defs/path"},
        "photos": {"$ref": "#/$defs/path"}
      }
    },
    "reference_dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "files"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "commit": {"$ref": "#/$defs/commit"},
        "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:]).+$"}
  }
}
