{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "locale", "product", "pins", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "locale": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "pins": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{40}$"}},
    "components": {"type": "array", "minItems": 7, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "state", "reason", "files", "reader_checks"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["original-text", "book", "translation", "portraits", "photographs", "fonts", "bundled-packages"]},
        "state": {"enum": ["specified", "unresolved", "not-applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "files": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "witness"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "witness": {"type": "string", "pattern": "^https://"}
          }
        }},
        "reader_checks": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "all_of"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "all_of": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }}
      }
    }}
  }
}
