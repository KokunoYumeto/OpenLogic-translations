{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "enum": [
        "pdflatex",
        "lualatex",
        "xelatex"
      ]
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "babel": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://github\\.com/"
      }
    },
    "preamble": {
      "type": "object",
      "properties": {
        "before_class": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\.tex$"
          },
          "uniqueItems": true
        },
        "before_olp": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\.tex$"
          },
          "uniqueItems": true
        },
        "after_olp": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+\\.tex$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "before_class",
        "before_olp",
        "after_olp"
      ],
      "additionalProperties": false
    },
    "strings": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "type": "string",
          "minLength": 1
        },
        "biographies": {
          "type": "string",
          "minLength": 1
        },
        "glossary": {
          "type": "string",
          "minLength": 1
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "figure",
        "biographies",
        "glossary",
        "initial"
      ],
      "additionalProperties": false
    },
