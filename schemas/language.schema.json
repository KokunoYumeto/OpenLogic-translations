      "required": ["single", "color", "minimum_contrast"],
      "properties": {
        "single": {"const": true},
        "color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "minimum_contrast": {"type": "number", "minimum": 7, "maximum": 21}
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "portrait_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "emergency_stretch": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:pt|em|ex)$"
        },
        "table_column_separation": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:pt|em|ex)$"
        },
        "portrait_spacing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "required": [
        "portrait_width",
        "portrait_spacing"
      ],
      "additionalProperties": false
