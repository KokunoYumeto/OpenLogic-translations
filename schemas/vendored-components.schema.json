{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["source", "mount", "commit"],
    "properties": {
      "source": {"enum": ["photos", "portraits", "slc"]},
      "mount": {"type": "string", "minLength": 1},
      "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "selection_evidence": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "commit", "path"],
        "properties": {
          "repository": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "path": {"type": "string", "minLength": 1}
        }
      },
      "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    },
    "dependentRequired": {"members": ["selection_evidence"]}
  }
}
